---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  /** Float over the page content (Home): fixed to the bottom, transparent. */
  overlay?: boolean;
}

const { lang, overlay = false } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer
  class:list={[
    // Same frosted glass as the header, hugging its text, squared off at the bottom edge.
    "site-footer glass mx-auto w-fit max-w-[calc(100%-1.5rem)] rounded-t-lg border-b-0 px-6 py-3 text-center text-xs text-foreground/70",
    overlay ? "pointer-events-none fixed inset-x-0 bottom-0 z-40" : "mt-10",
  ]}
>
  © {year} {t("site.name")}. {t("footer.rights")}
</footer>
