---
import { homeIntro, type Lang } from "../i18n/ui";
import { localizedPath, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const segments = homeIntro[lang];
---

<section class="hero flex flex-col gap-6" data-hero>
  <p class="max-w-xl text-lg text-muted" data-hero-intro>
    {
      segments.map((s) =>
        s.scramble ? (
          <em class="hero-scramble not-italic text-foreground" data-scramble={s.text}>
            {s.text}
          </em>
        ) : (
          s.text
        ),
      )
    }
  </p>
  <div class="mt-4 flex flex-wrap gap-4 text-sm">
    <a
      href={localizedPath("services", lang)}
      class="rounded-full bg-foreground px-5 py-2.5 font-medium text-background transition-colors hover:bg-foreground/85"
      data-magnetic
    >
      {t("home.cta.services")}
    </a>
    <a
      href={localizedPath("about", lang)}
      class="rounded-full border border-muted/40 px-5 py-2.5 font-medium transition-colors hover:border-foreground"
      data-magnetic
    >
      {t("home.cta.about")}
    </a>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";

  gsap.registerPlugin(ScrambleTextPlugin);

  const hero = document.querySelector<HTMLElement>("[data-hero]");

  if (hero) {
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const hasPointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

      // Entrance for intro, scramble words and CTAs runs once.
      const entrance = gsap.timeline({ delay: 0.3 });
      entrance
        .from("[data-hero-intro]", { y: 16, autoAlpha: 0, duration: 0.6, ease: "power3.out" })
        .from(
          "[data-magnetic]",
          { y: 12, autoAlpha: 0, duration: 0.5, stagger: 0.1, ease: "power3.out" },
          "-=0.3",
        );
      document.querySelectorAll<HTMLElement>("[data-scramble]").forEach((el, i) => {
        entrance.to(
          el,
          {
            duration: 1,
            scrambleText: { text: el.dataset.scramble ?? el.textContent ?? "", chars: "lowerCase", speed: 0.4 },
          },
          0.2 + i * 0.15,
        );
      });

      // Magnetic CTAs
      const magnets = Array.from(hero.querySelectorAll<HTMLElement>("[data-magnetic]"));
      const magnetCleanup = magnets.map((el) => {
        const xTo = gsap.quickTo(el, "x", { duration: 0.4, ease: "power3.out" });
        const yTo = gsap.quickTo(el, "y", { duration: 0.4, ease: "power3.out" });
        const move = (e: PointerEvent) => {
          const r = el.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          xTo(dx * 0.3);
          yTo(dy * 0.3);
        };
        const leave = () => gsap.to(el, { x: 0, y: 0, duration: 0.8, ease: "elastic.out(1, 0.4)" });
        if (hasPointer) {
          el.addEventListener("pointermove", move);
          el.addEventListener("pointerleave", leave);
        }
        return () => {
          el.removeEventListener("pointermove", move);
          el.removeEventListener("pointerleave", leave);
        };
      });

      return () => {
        entrance.kill();
        magnetCleanup.forEach((fn) => fn());
      };
    });
  }
</script>
