---
/**
 * The site-wide 3D background: a fixed canvas behind every page, drawn by
 * `src/lib/site-background.ts` (Three.js, loaded when the browser is idle so it never
 * delays the page). Strong on Home, dimmed behind the text pages; `colour` tints it
 * with a service's key colour and `shape` gives it that service's shape.
 * Any element with `data-svc-id` (and `data-svc-key`) drives the mesh while it is
 * hovered or focused: the script below copies them to `data-bg-shape` / `data-bg-key`
 * on <html>, which the background reads every frame.
 */
interface Props {
  variant: "home" | "page";
  /** Key colour for this page (service subpages). */
  colour?: string;
  /** Service id whose shape the mesh takes on this page (service subpages). */
  shape?: string;
}

const { variant, colour, shape } = Astro.props;
---

<canvas class="site-bg" aria-hidden="true" data-site-bg data-bg={variant} data-bg-key={colour} data-bg-shape={shape}></canvas>

<style>
  .site-bg {
    position: fixed;
    inset: 0;
    z-index: -10;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .site-bg[data-ready] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-bg {
      transition: none;
    }
  }
  /* Behind text pages the mesh steps back. */
  .site-bg[data-bg="page"][data-ready] {
    opacity: 0.45;
  }
  /* A service's shape sits partly under its text: fainter still. */
  .site-bg[data-bg="page"][data-bg-shape][data-ready] {
    opacity: 0.32;
  }
</style>

<script>
  const root = document.documentElement;
  document.querySelectorAll<HTMLElement>("[data-svc-id]").forEach((el) => {
    const on = () => {
      root.dataset.bgShape = el.dataset.svcId;
      root.dataset.bgKey = el.dataset.svcKey;
    };
    const off = () => {
      delete root.dataset.bgShape;
      delete root.dataset.bgKey;
    };
    el.addEventListener("pointerenter", on);
    el.addEventListener("pointerleave", off);
    el.addEventListener("focus", on);
    el.addEventListener("blur", off);
  });

  const canvas = document.querySelector<HTMLCanvasElement>("[data-site-bg]");
  if (canvas) {
    const load = () => import("../lib/site-background").then((m) => m.initBackground(canvas));
    if ("requestIdleCallback" in window) requestIdleCallback(load, { timeout: 1500 });
    else setTimeout(load, 200);
  }
</script>
