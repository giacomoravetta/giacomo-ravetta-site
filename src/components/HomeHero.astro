---
/**
 * Home: a full-screen hero with one animation behind everything (footage of me coding,
 * dithered live, gathering out of scattered pixels on load) and
 * the slogan alone on a yellow plate (Terminal Grotesque, hollow block cursor, a glitch running
 * through it every few seconds), centred vertically on desktop and horizontally below lg; then one full-screen
 * section per service: its name, summary and a link
 * to the subpage beside its 1-bit pixel figure (`PixelFigure.astro`); and a closing call
 * to action in reverse (yellow on black) that links to the meeting booking page.
 * The figures run on the clock: each builds up once when its section first arrives, then
 * keeps playing whatever the scroll position (see pixel-figures.ts). The hero quote rises in word by
 * word, and each section's text rises in when the section arrives (GSAP, below).
 */
import type { Lang } from "../i18n/ui";
import { localizedPath, useTranslations } from "../i18n/utils";
import { serviceIds, services, serviceStyle } from "../i18n/services";
import PixelFigure from "./PixelFigure.astro";
import BookingCta from "./BookingCta.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The hero dithers real footage when the clip exists (made by scripts/hero-video.sh);
// without it, the drawn side-view coder is shown.
const heroVideo = "/video/hero-coding.mp4";
// (A lazy glob only lists the file at build time; it is served from public/, not bundled.)
const hasHeroVideo = Object.keys(import.meta.glob("/public/video/hero-coding.mp4")).length > 0;
---

<section
  class="relative isolate flex min-h-dvh flex-col pt-44 pb-24 md:-mt-[var(--header-h)] md:pt-[calc(var(--header-h)+3rem)] lg:justify-center lg:py-[var(--header-h)]"
>
  <!-- The one hero animation, behind the text and as large as the section. -->
  <div class="absolute inset-0 -z-10">
    <PixelFigure figure="focus" cells={450} video={hasHeroVideo ? heroVideo : undefined} />
  </div>
  <!-- Text sits on yellow plates so it stays readable over the black pixels. -->
  <div class="pointer-events-none flex flex-col items-center gap-5 px-6 lg:items-start lg:px-12">
    <h1
      class="pointer-events-auto w-fit max-w-[7.9em] bg-background lg:max-w-[6.2em] px-3 py-2 font-terminal text-[clamp(2.75rem,min(8.5vw,15dvh),8.5rem)] max-lg:text-[clamp(2.75rem,13dvw,7rem)] leading-[0.92] tracking-tight text-balance max-lg:text-center"
      data-hero-quote
    >
      {t("home.heading")}
    </h1>
  </div>
</section>

<div id="services">
  {
    serviceIds.map((id, i) => (
      <section class="grid min-h-dvh border-t-2 border-foreground lg:grid-cols-2" data-svc-section>
        <div
          class:list={[
            "flex flex-col justify-center gap-6 px-6 py-12 lg:px-12 lg:py-24",
            i % 2 === 1 && "lg:order-2 lg:border-l-2 lg:border-foreground",
          ]}
        >
          <span class="font-terminal text-xl" data-rise>
            {String(i + 1).padStart(2, "0")} / {String(serviceIds.length).padStart(2, "0")}
          </span>
          <h2
            class:list={["text-[clamp(2.5rem,min(5.4vw,11dvh),5.5rem)] leading-[0.95] tracking-tight text-balance", serviceStyle[id].font]}
            data-rise
          >
            {services[id][lang].name}
          </h2>
          <p class="max-w-xl text-lg lg:text-xl" data-rise>{services[id][lang].summary}</p>
          <ul class="flex max-w-xl flex-wrap gap-2 font-terminal text-sm" data-rise>
            {services[id][lang].items.map((item) => <li class="border-2 border-foreground px-2.5 py-1">{item.name}</li>)}
          </ul>
          <a href={localizedPath(id, lang)} class="svc-link self-start border-2 border-foreground px-5 py-3 text-lg font-semibold" data-rise>
            {t("services.more")} <span aria-hidden="true">→</span>
          </a>
        </div>
        <div
          class:list={[
            "relative min-h-[55dvh] max-lg:order-first max-lg:border-b-2 max-lg:border-foreground",
            i % 2 === 0 && "lg:border-l-2 lg:border-foreground",
          ]}
        >
          <PixelFigure figure={id} />
        </div>
      </section>
    ))
  }
</div>

<BookingCta lang={lang} />

<style>
  /* 1-bit: states switch, they do not fade. */
  .svc-link {
    background: var(--color-foreground);
    color: var(--color-background);
    box-shadow: 4px 4px 0 var(--color-foreground);
  }
  .svc-link:hover,
  .svc-link:focus-visible {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  /* Hollow block cursor after the hero slogan (added by the script below, so not scoped). */
  :global(.hero-cursor) {
    display: inline-block;
    box-sizing: border-box;
    width: 0.48em;
    height: 0.72em;
    margin-left: 0.08em;
    border: 0.07em solid currentColor;
    animation: hero-cursor 1.1s steps(1, end) infinite;
  }
  @keyframes hero-cursor {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(SplitText, ScrollTrigger);
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    // Hero: the slogan rises word by word out of clipped lines, a block cursor blinks at
    // its end, and every few seconds a glitch runs through it left to right: each letter
    // flickers through a few code characters and settles back. Letters keep their width
    // (set in em once the font is in), so nothing reflows while they flicker.
    const quote = document.querySelector<HTMLElement>("[data-hero-quote]");
    let split: SplitText | undefined;
    let alive = true;
    let chars: HTMLElement[] = [];
    if (quote) {
      const cursor = document.createElement("span");
      cursor.className = "hero-cursor";
      cursor.setAttribute("aria-hidden", "true");
      // Split only once the font is in (with the fallback face the lines break differently);
      // autoSplit then splits again whenever the lines change (resize), so the letters,
      // their widths and the cursor are set up afresh each time.
      const create = () => {
        if (!alive) return;
        split = SplitText.create(quote, {
        type: "lines,words,chars",
        mask: "lines",
        autoSplit: true,
        onSplit(self) {
          const size = parseFloat(getComputedStyle(quote).fontSize);
          chars = self.chars as HTMLElement[];
          for (const el of chars) {
            el.dataset.char = el.textContent ?? "";
            el.style.width = `${el.getBoundingClientRect().width / size}em`;
            el.style.textAlign = "center";
          }
          self.lines[self.lines.length - 1]?.append(cursor);
          return gsap.from(self.words, { yPercent: 110, duration: 0.9, ease: "power3.out", stagger: 0.07, delay: 0.1 });
        },
        });
      };
      document.fonts.ready.then(create);

      const GLYPHS = "01<>/[]{}#*=+-_";
      const flicker = (el: HTMLElement, left: number) => {
        if (!alive || !el.isConnected) return;
        el.textContent = left > 0 ? GLYPHS[Math.floor(Math.random() * GLYPHS.length)] : (el.dataset.char ?? "");
        if (left > 0) gsap.delayedCall(0.055, flicker, [el, left - 1]);
      };
      const glitch = () => {
        if (!alive) return;
        chars.forEach((el, i) => gsap.delayedCall(i * 0.035, flicker, [el, 4]));
        gsap.delayedCall(6, glitch);
      };
      gsap.delayedCall(3.5, glitch);
    }

    // Services: each section's text rises in when the section arrives.
    document.querySelectorAll<HTMLElement>("[data-svc-section]").forEach((section) => {
      gsap.from(section.querySelectorAll("[data-rise]"), {
        autoAlpha: 0,
        y: 40,
        duration: 0.7,
        ease: "power2.out",
        stagger: 0.09,
        scrollTrigger: { trigger: section, start: "top 65%", once: true },
      });
    });
    return () => {
      alive = false;
      split?.revert();
    };
  });
</script>
