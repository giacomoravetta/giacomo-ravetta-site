---
/**
 * Home hero: "The Battle of Shijo Nawate" triptych.
 * Panels rest desaturated. A canvas on top paints the colour version through a
 * textured brush stroke that follows the cursor and slowly dries (fades). When the
 * pointer is nearly still, a sumi-ink blot (and two smaller drops) bleeds out from
 * it, washing colour over the whole hovered panel. It stays lit until the pointer leaves the panel, then the colour dries.
 * Hovering a panel also reveals its label.
 * Touch / reduced-motion: full colour, labels always visible (CSS only, script never runs).
 */
import type { Lang } from "../i18n/ui";
import { localizedPath, useTranslations } from "../i18n/utils";
import { getTriptychImages, type TriptychImages } from "../lib/triptych-images";
import HeroScenes from "./HeroScenes.astro";

interface Props {
  lang: Lang;
  /** Pass the result of getTriptychImages() when the page also preloads them in <head>. */
  images?: TriptychImages;
}

const { lang, images = await getTriptychImages() } = Astro.props;
const t = useTranslations(lang);
// Home side panels → Services subpages; the centre → About me.
// Side panels → Services subpages; the centre links nowhere.
const pageFor = { left: "designer", right: "developer" } as const;

const panels = images.map((p) => ({
  ...p,
  label: t(`hero.${p.key}`),
  alt: t(`hero.alt.${p.key}`),
  href: p.key === "center" ? undefined : localizedPath(pageFor[p.key], lang),
}));
---

<section class="triptych" data-triptych aria-label={t("site.tagline")}>
  <div class="grid">
    {
      panels.map((p) => (
        <figure class="panel" data-panel={p.key}>
          <img
            class="layer layer-base"
            src={p.img.src}
            srcset={p.img.srcSet.attribute}
            sizes={p.sizes}
            width={p.img.attributes.width}
            height={p.img.attributes.height}
            alt={p.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            draggable="false"
            data-image
          />
          <span class="tint" aria-hidden="true" data-tint />
          {p.href && <a class="panel-link" href={p.href} data-astro-prefetch="hover" aria-label={p.label} />}
          {p.key === "center" ? (
            <h1 class="sr-only" data-label>
              {p.label}
            </h1>
          ) : (
            <>
            <p
              class:list={["label", "label-side", `label-${p.key}`, p.key === "left" ? "font-bluu" : "font-terminal"]}
              style={`--chars: ${p.label.length}`}
              data-label
            >
              <span class="label-text">{p.label}</span>
            </p>
            </>
          )}
        </figure>
      ))
    }
  </div>

  <!-- Colour "paint" layer: the script draws the colour images through a brush-stroke mask. -->
  <canvas class="paint" aria-hidden="true" data-paint></canvas>

  <!-- Hover effects of the side panels (shared with the mobile hero). -->
  <HeroScenes lang={lang} />

</section>

<!-- Runs before first paint: park the panels offscreen until every image is decoded,
     then drop the class and let the CSS transition slide them up. Without JS the
     class is never added, so the panels simply render in place. -->
<script is:inline>
  (() => {
    const root = document.querySelector("[data-triptych]");
    if (!root) return;
    root.classList.add("is-loading");
    const images = Array.from(root.querySelectorAll("[data-image]"));
    Promise.all(images.map((img) => img.decode().catch(() => undefined))).then(() => {
      // Two frames so the offscreen state is committed before the transition starts.
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          root.classList.remove("is-loading");
          // Announce "in place" once the last panel's slide finishes (or right away
          // when there is no transition, e.g. reduced motion). Timeout is a safety net.
          const last = root.querySelector('[data-panel="right"]');
          const done = () => {
            if (root.dataset.ready) return;
            root.dataset.ready = "1";
            root.dispatchEvent(new CustomEvent("triptych:ready"));
          };
          const t = last ? parseFloat(getComputedStyle(last).transitionDuration) : 0;
          if (!last || !t) done();
          else {
            last.addEventListener("transitionend", done, { once: true });
            setTimeout(done, (t + parseFloat(getComputedStyle(last).transitionDelay || "0")) * 1000 + 200);
          }
        }),
      );
    });
  })();
</script>

<style>
  /* Full viewport. The three panels form one strip (3802 × 2145) that is scaled
     uniformly to cover the viewport and centred, so the scene stays continuous
     across the seams and only the outer edges are clipped. */
  .triptych {
    position: relative;
    display: grid;
    place-items: center;
    height: 100svh;
    overflow: hidden;
    background: var(--color-background);
    /* Slide under the translucent sticky header so it blurs the artwork. */
    margin-top: calc(-1 * var(--header-h, 4.5rem));
  }

  /* Columns follow the three panel widths (1164 / 1478 / 1160). The strip is as wide
     as needed to cover the viewport at its native ratio (like object-fit: cover). */
  .grid {
    display: grid;
    grid-template-columns: 1164fr 1478fr 1160fr;
    width: max(100%, calc(100svh * 3802 / 2145));
    aspect-ratio: 3802 / 2145;
  }

  .panel {
    position: relative;
    overflow: hidden;
    margin: 0;
  }

  .layer {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    -webkit-user-drag: none;
    user-select: none;
    object-fit: fill; /* each panel already has its image's exact aspect ratio */
  }

  .layer-base {
    filter: grayscale(1);
    opacity: 0.55;
  }

  .paint {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* How far the strip overflows the viewport on each side (0 on wide screens).
     Side labels add it so they stay inside the visible area. */
  .triptych {
    --overflow: max(0px, (100svh * 3802 / 2145 - 100vw) / 2);
  }

  /* Whole-panel link, above paint and label so the panel is one big hit target. */
  .panel-link {
    position: absolute;
    inset: 0;
    z-index: 3;
    cursor: pointer;
  }

  .label {
    position: absolute;
    z-index: 2; /* above the paint layer; panels must not form stacking contexts */
    margin: 0;
    font-weight: 600;
    color: var(--color-foreground);
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.6);
    pointer-events: none;
    /* Promote the words (and the split letters inside) to compositor layers
       ahead of the first hover, so the tween never has to create them mid-frame. */
    will-change: transform, opacity;
  }
  .label .char {
    will-change: transform, opacity;
  }

  /* Side labels read vertically (top → bottom) along the outer edges, centred.
     The font size is derived from the character count so the word spans ~70dvh
     (per-face average lowercase advance, `--adv`). */
  .label-side {
    /* Centred without CSS translate (GSAP folds individual transform props into
       its own transform): the box is 70dvh + vertical padding tall. */
    top: 50%;
    margin-top: -35dvh;
    writing-mode: vertical-rl;
    white-space: nowrap;
    font-size: calc(70dvh / (var(--chars, 9) * var(--adv, 0.47)));
    letter-spacing: -0.02em;
    line-height: 1;
  }
  /* Glyphs turned anticlockwise so the word reads bottom → top. The rotation lives
     on an inner span, so GSAP's transform tweens on the label never touch it. */
  .label-side .label-text {
    display: block;
    rotate: 180deg;
  }
  /* --adv: average lowercase advance of each face (Bluu Next Bold ≈ 0.47em,
     Terminal Grotesque ≈ 0.42em) so both words span the same length. */
  .label-left {
    --adv: 0.47;
    left: calc(1.5rem + var(--overflow));
  }
  .label-right {
    --adv: 0.416;
    right: calc(1.5rem + var(--overflow));
  }

  /* Panels dimmed by a hover are covered by a solid, neutral ink black; the effects
     over them use the hovered side's key colour (--fx-key) and its complement (--fx-alt). */
  .triptych {
    --fx-key: #ff6a3d;
    --fx-alt: #19c3c9;
    --fx-bg: #0e0d0c;
  }
  .tint {
    position: absolute;
    inset: 0;
    z-index: 2; /* over the paint canvas too, so no brush colour shows through; the
                   effects (.fx, later in the DOM) and the panel links stay on top */
    background: var(--fx-bg);
    opacity: 0;
    pointer-events: none;
  }

  /* Interactive mode: side labels start hidden, GSAP reveals them. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .label-side {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* Touch or reduced motion: everything in colour, labels visible, no paint layer. */
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .layer-base {
      filter: none;
      opacity: 1;
    }
    .paint,
    .tint {
      display: none;
    }
  }

  /* Phones, tablets and touch devices get the scroll-driven Svelte version instead
     (see MobileTriptych.svelte and .scroll-hero in global.css). */
  @media (max-width: 1023px), (hover: none), (pointer: coarse) {
    .triptych {
      display: none;
    }
  }

</style>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  import { createHeroScenes, makeBoard, FX_COLORS } from "../lib/hero-scenes";

  gsap.registerPlugin(SplitText, ScrambleTextPlugin);
  // Keep animated elements on their own compositor layers after a tween ends
  // (the default "auto" drops back to 2D transforms, which can repaint).
  gsap.config({ force3D: true });

  const root = document.querySelector<HTMLElement>("[data-triptych]");

  if (root) {
    const mm = gsap.matchMedia();

    mm.add(
      // Same split as the CSS: wide screens with a mouse. Shrinking the window past
      // 1024px reverts this block (listeners, ticker) and the phone hero takes over.
      "(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) and (min-width: 1024px)",
      () => {
        const canvas = root.querySelector<HTMLCanvasElement>("[data-paint]")!;
        const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));
        const images = panels.map((p) => p.querySelector<HTMLImageElement>("[data-image]")!);

        const STILL_SPEED = 0.25; // px/ms; below this the pointer counts as "barely moving"
        const STILL_AFTER = 60; // ms without a move → speed decays to 0
        const DRY = 0.028; // per-frame alpha removed from the stroke (how fast paint "dries")
        const DPR = Math.min(window.devicePixelRatio || 1, 2);

        const baseRadius = () => gsap.utils.clamp(64, 110, window.innerWidth * 0.055);

        // ---- Brush tip: a rough, bristly stamp pre-rendered once (unit size 256px). ----
        const TIP = 256;
        const tip = document.createElement("canvas");
        tip.width = tip.height = TIP;
        {
          const c = tip.getContext("2d")!;
          const rnd = gsap.utils.random;
          // Soft body
          const g = c.createRadialGradient(TIP / 2, TIP / 2, 0, TIP / 2, TIP / 2, TIP / 2);
          g.addColorStop(0, "rgba(0,0,0,0.9)");
          g.addColorStop(0.55, "rgba(0,0,0,0.55)");
          g.addColorStop(1, "rgba(0,0,0,0)");
          c.fillStyle = g;
          c.fillRect(0, 0, TIP, TIP);
          // Bristles: scattered soft dabs that break the edge
          for (let i = 0; i < 70; i++) {
            const a = rnd(0, Math.PI * 2);
            const d = rnd(TIP * 0.18, TIP * 0.46);
            const x = TIP / 2 + Math.cos(a) * d;
            const y = TIP / 2 + Math.sin(a) * d;
            const r = rnd(TIP * 0.04, TIP * 0.12);
            const bg = c.createRadialGradient(x, y, 0, x, y, r);
            bg.addColorStop(0, `rgba(0,0,0,${rnd(0.25, 0.6)})`);
            bg.addColorStop(1, "rgba(0,0,0,0)");
            c.fillStyle = bg;
            c.fillRect(x - r, y - r, r * 2, r * 2);
          }
        }

        // ---- Dry-brush tip: thin, wavy bristle lines with gaps (fast strokes split into hairs). ----
        const dryTip = document.createElement("canvas");
        dryTip.width = dryTip.height = TIP;
        {
          const c = dryTip.getContext("2d")!;
          const rnd = gsap.utils.random;
          c.lineCap = "round";
          for (let i = 0; i < 14; i++) {
            const y = TIP * (0.18 + (0.64 * i) / 13) + rnd(-4, 4);
            // Lines thin out towards the top and bottom edges of the brush.
            const edge = 1 - Math.abs(y / TIP - 0.5) * 2;
            c.strokeStyle = `rgba(0,0,0,${rnd(0.35, 0.9) * (0.5 + edge * 0.5)})`;
            c.lineWidth = rnd(2, 7) * (0.5 + edge * 0.5);
            const x0 = rnd(0, TIP * 0.25);
            const x1 = TIP - rnd(0, TIP * 0.3);
            c.beginPath();
            c.moveTo(x0, y);
            c.bezierCurveTo(TIP * 0.35, y + rnd(-6, 6), TIP * 0.65, y + rnd(-6, 6), x1, y + rnd(-4, 4));
            c.stroke();
          }
        }

        // ---- Canvases: `stroke` accumulates the mask, `canvas` composites colour through it. ----
        const stroke = document.createElement("canvas");
        const sctx = stroke.getContext("2d")!;
        const ctx = canvas.getContext("2d")!;
        let W = 0;
        let H = 0;
        let rects: { x: number; y: number; w: number; h: number }[] = [];

        const resize = () => {
          const r = root.getBoundingClientRect();
          W = Math.round(r.width);
          H = Math.round(r.height);
          canvas.width = stroke.width = Math.round(W * DPR);
          canvas.height = stroke.height = Math.round(H * DPR);
          ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
          sctx.setTransform(DPR, 0, 0, DPR, 0, 0);
          // Layout positions (offset*), not bounding boxes: during the load-in the panels
          // are translated a viewport down, and the paint must land where they end up.
          rects = panels.map((p) => ({ x: p.offsetLeft, y: p.offsetTop, w: p.offsetWidth, h: p.offsetHeight }));
        };
        resize();

        // Draw a colour image into its panel rect (root-relative; may extend past the
        // root edges, the canvas clips it). The panel has the image's exact aspect ratio.
        const drawPanel = (img: HTMLImageElement, rc: (typeof rects)[number]) => {
          if (!img.naturalWidth || !img.naturalHeight) return;
          ctx.drawImage(img, rc.x, rc.y, rc.w, rc.h);
        };

        // ---- Pointer / brush state ----
        const pos = { x: 0, y: 0 }; // eased brush position
        let raw = { x: 0, y: 0 };
        let prev = { x: 0, y: 0 };
        let angle = 0;
        let active = -1;
        let visible = false;
        let speed = 0;
        let lastMove = 0;
        let alive = 0; // frames left to keep compositing after the stroke has dried
        // Calligraphy: eased speed (px/frame) → brush pressure (1 slow/wet … 0 fast/dry).
        let vel = 0;
        let pressure = 1;
        let lastR = 0;
        let lastSpatter = 0;

        // ---- Ink wash: a resting pointer lets a sumi-ink blot bleed out over the panel. ----
        // One blot texture, made once; each frame it is only stamped (scaled up) into the
        // stroke mask a few times, so the effect costs a handful of drawImage calls.
        const BLOT = 512;
        const blot = document.createElement("canvas");
        blot.width = blot.height = BLOT;
        {
          const c = blot.getContext("2d")!;
          const rnd = gsap.utils.random;
          const C = BLOT / 2;
          const dab = (x: number, y: number, r: number, a: number) => {
            const g = c.createRadialGradient(x, y, 0, x, y, r);
            g.addColorStop(0, `rgba(0,0,0,${a})`);
            g.addColorStop(1, "rgba(0,0,0,0)");
            c.fillStyle = g;
            c.fillRect(x - r, y - r, r * 2, r * 2);
          };
          // Body: dense in the middle so the colour fills solidly behind the edge.
          dab(C, C, C * 0.62, 1);
          dab(C, C, C * 0.5, 1);
          // Lobes: overlapping soft dabs at uneven radii break the outline.
          for (let i = 0; i < 40; i++) {
            const ang = rnd(0, Math.PI * 2);
            const d = rnd(C * 0.2, C * 0.55);
            dab(C + Math.cos(ang) * d, C + Math.sin(ang) * d, rnd(C * 0.12, C * 0.3), rnd(0.5, 0.95));
          }
          // Rim: tiny thin dabs, the fibres the ink creeps along in the paper.
          for (let i = 0; i < 120; i++) {
            const ang = rnd(0, Math.PI * 2);
            const d = rnd(C * 0.55, C * 0.9);
            dab(C + Math.cos(ang) * d, C + Math.sin(ang) * d, rnd(C * 0.015, C * 0.06), rnd(0.25, 0.7));
          }
        }
        const BLOOM_DURATION = 2.6; // seconds for the ink to reach the far corners
        type Blot = { s: number; x: number; y: number; rot: number };
        const bloom = {
          on: false,
          done: false,
          clip: undefined as (typeof rects)[number] | undefined,
          blots: [] as Blot[],
          tl: undefined as gsap.core.Timeline | undefined,
        };

        // While a single panel blooms into colour, the other two are covered by a solid
        // fill in its complementary colour (.tint, colour set per hovered side in `enter`).
        const DIM_OPACITY = 0.5;
        const tints = panels.map((p) => p.querySelector<HTMLElement>("[data-tint]")!);
        const baseOpacity = parseFloat(getComputedStyle(images[0]).opacity); // .layer-base
        let dimmed = false;
        const dimOthers = (on: boolean) => {
          if (dimmed === on) return;
          dimmed = on;
          const others = images.filter((_, i) => i !== active);
          if (on) {
            gsap.to(others, { opacity: DIM_OPACITY, duration: 0.8, ease: "power2.out", overwrite: "auto" });
            gsap.to(tints.filter((_, i) => i !== active), { opacity: 1, duration: 0.8, ease: "power2.out", overwrite: "auto" });
          } else {
            gsap.to(images, { opacity: baseOpacity, duration: 0.6, ease: "sine.inOut", overwrite: "auto", clearProps: "opacity" });
            gsap.to(tints, { opacity: 0, duration: 0.6, ease: "sine.inOut", overwrite: "auto" });
          }
        };

        // The centre panel reveals the whole work: its bloom covers all three panels (their
        // visible span) and nothing dims. A side panel blooms alone and dims the others.
        const isWhole = (i: number) => panels[i]?.dataset.panel === "center";
        const bloomRect = (i: number) => {
          if (!isWhole(i)) return rects[i];
          const x0 = Math.max(0, Math.min(...rects.map((r) => r.x)));
          const x1 = Math.min(W, Math.max(...rects.map((r) => r.x + r.w)));
          return { x: x0, y: 0, w: x1 - x0, h: H };
        };
        const startBloom = (i: number) => {
          const rc = bloomRect(i);
          const whole = isWhole(i);
          const rnd = gsap.utils.random;
          // The pointer drops the ink; two smaller drops land nearby a moment later.
          const blots: Blot[] = [{ s: 0, x: pos.x, y: pos.y, rot: rnd(0, Math.PI * 2) }];
          for (let k = 0; k < 2; k++) {
            const ang = rnd(0, Math.PI * 2);
            const d = rnd(0.12, 0.3) * Math.min(rc.w, rc.h);
            blots.push({ s: 0, x: pos.x + Math.cos(ang) * d, y: pos.y + Math.sin(ang) * d, rot: rnd(0, Math.PI * 2) });
          }
          // Whole work: a drop also lands in the middle of each side panel, so the ink
          // floods the strip from three points instead of crawling out from the centre.
          if (whole)
            rects.forEach((r, k) => {
              if (k !== i) blots.push({ s: 0, x: r.x + r.w / 2 + rnd(-40, 40), y: r.y + r.h * rnd(0.35, 0.65), rot: rnd(0, Math.PI * 2) });
            });
          bloom.tl?.kill();
          const tl = gsap.timeline({ onComplete: () => (bloom.done = true) });
          blots.forEach((b, k) => {
            // Scale at which the blot's lobes (about 0.75 of its radius) reach the farthest
            // corner of the panel; the solid fill at the end covers what the rim misses.
            const far = Math.max(
              Math.hypot(b.x - rc.x, b.y - rc.y),
              Math.hypot(b.x - rc.x - rc.w, b.y - rc.y),
              Math.hypot(b.x - rc.x, b.y - rc.y - rc.h),
              Math.hypot(b.x - rc.x - rc.w, b.y - rc.y - rc.h),
            );
            const to = far / (BLOT / 2) / 0.75;
            tl.to(b, { s: to, duration: BLOOM_DURATION * (k === 0 ? 1 : 0.8), ease: "sine.inOut" }, k === 0 ? 0 : rnd(0.25, 0.5));
          });
          Object.assign(bloom, { on: true, done: false, clip: rc, blots, tl });
          if (!whole) dimOthers(true);
        };
        const stopBloom = () => {
          if (!bloom.on) return;
          bloom.on = false;
          bloom.tl?.kill();
          dimOthers(false);
        };

        // Stamp the blots into the stroke mask (the drying fades them like the brush).
        const drawBloom = () => {
          const rc = bloom.clip;
          if (!rc) return;
          sctx.save();
          sctx.beginPath();
          sctx.rect(rc.x, rc.y, rc.w, rc.h);
          sctx.clip();
          if (bloom.done) {
            sctx.fillStyle = "#000";
            sctx.fillRect(rc.x, rc.y, rc.w, rc.h);
          } else {
            for (const b of bloom.blots) {
              if (b.s <= 0) continue;
              sctx.save();
              sctx.translate(b.x, b.y);
              sctx.rotate(b.rot);
              sctx.scale(b.s, b.s);
              sctx.drawImage(blot, -BLOT / 2, -BLOT / 2);
              sctx.restore();
            }
          }
          sctx.restore();
        };

        const xTo = gsap.quickTo(pos, "x", { duration: 0.35, ease: "power3.out" });
        const yTo = gsap.quickTo(pos, "y", { duration: 0.35, ease: "power3.out" });

        // Stamp a tip at (x, y) with radius r, rotated along the stroke.
        const stamp = (x: number, y: number, r: number, a: number, alpha: number, img = tip, sx = 1.15, sy = 0.9) => {
          sctx.save();
          sctx.globalAlpha = alpha;
          sctx.translate(x, y);
          sctx.rotate(a);
          // Elongated along the movement direction, like a dragged brush.
          sctx.scale(sx, sy);
          sctx.drawImage(img, -r, -r, r * 2, r * 2);
          sctx.restore();
        };

        const tick = () => {
          if (!visible && alive <= 0) return;

          // Dry: fade the whole stroke a little each frame.
          sctx.save();
          sctx.setTransform(1, 0, 0, 1, 0, 0);
          sctx.globalCompositeOperation = "destination-out";
          sctx.fillStyle = `rgba(0,0,0,${DRY})`;
          sctx.fillRect(0, 0, stroke.width, stroke.height);
          sctx.restore();

          if (visible) {
            // Resting drops the ink; once it has spread the panel stays in colour
            // until the pointer leaves it.
            if (performance.now() - lastMove > STILL_AFTER) speed = 0;
            const still = speed < STILL_SPEED;
            if (active >= 0 && still && !bloom.on) startBloom(active);
            if (bloom.on) drawBloom();

            // Lay ink along the eased path like a sumi-e brush: slow = wide and wet,
            // fast = narrow, tapering and split into dry bristle streaks.
            const dx = pos.x - prev.x;
            const dy = pos.y - prev.y;
            const dist = Math.hypot(dx, dy);
            vel += (dist - vel) * 0.25;
            pressure += (1 - gsap.utils.clamp(0, 1, vel / 22) - pressure) * 0.2; // ~22px/frame (eased) = fully dry
            const prevAngle = angle;
            if (dist > 0.5) angle = Math.atan2(dy, dx);
            const r = baseRadius() * gsap.utils.interpolate(0.35, 1.15, pressure);
            const r0 = lastR || r;
            lastR = r;
            const alpha = gsap.utils.interpolate(0.3, 0.42, pressure);
            const dry = pressure < 0.5;
            const step = Math.max(4, Math.min(r, r0) * 0.18);
            const n = Math.max(1, Math.ceil(dist / step));
            for (let i = 1; i <= n; i++) {
              const t = i / n;
              const ri = r0 + (r - r0) * t; // taper smoothly within the frame
              const jitter = ri * 0.06;
              const x = prev.x + dx * t + gsap.utils.random(-jitter, jitter);
              const y = prev.y + dy * t + gsap.utils.random(-jitter, jitter);
              stamp(x, y, ri * gsap.utils.random(0.92, 1.08), angle + gsap.utils.random(-0.25, 0.25), alpha);
              if (dry) stamp(x, y, ri * 1.1, angle + gsap.utils.random(-0.08, 0.08), 0.7 * (1 - pressure), dryTip, 1.6, 0.7);
            }

            // Sharp turn at speed: flick a few ink drops off the brush.
            let turn = Math.abs(angle - prevAngle);
            if (turn > Math.PI) turn = Math.PI * 2 - turn;
            const now = performance.now();
            if (turn > 1.1 && vel > 8 && now - lastSpatter > 120) {
              lastSpatter = now;
              for (let k = gsap.utils.random(4, 7, 1); k > 0; k--) {
                const d = r * gsap.utils.random(0.6, 1.6);
                const a = prevAngle + gsap.utils.random(-0.5, 0.5);
                stamp(prev.x + Math.cos(a) * d, prev.y + Math.sin(a) * d, gsap.utils.random(3, 9), 0, gsap.utils.random(0.5, 0.8), tip, 1, 1);
              }
            }
            prev = { x: pos.x, y: pos.y };
            alive = 90;
          } else {
            alive--;
          }

          // Composite: colour images, kept only where the stroke mask has paint.
          ctx.clearRect(0, 0, W, H);
          ctx.globalCompositeOperation = "source-over";
          images.forEach((img, i) => drawPanel(img, rects[i]));
          ctx.globalCompositeOperation = "destination-in";
          ctx.drawImage(stroke, 0, 0, W, H);
          ctx.globalCompositeOperation = "source-over";
        };

        const onMove = (e: PointerEvent) => {
          const rr = root.getBoundingClientRect();
          const x = e.clientX - rr.left;
          const y = e.clientY - rr.top;
          const now = performance.now();
          if (!visible) {
            visible = true;
            pos.x = x;
            pos.y = y;
            prev = { x, y };
            speed = 0;
            vel = 0;
            pressure = 1;
            lastR = 0;
            gsap.to(canvas, { autoAlpha: 1, duration: 0.4, ease: "power2.out", overwrite: "auto" });
          } else {
            const dt = Math.max(1, now - lastMove);
            const inst = Math.hypot(x - raw.x, y - raw.y) / dt;
            speed = speed * 0.5 + inst * 0.5; // smoothed
          }
          raw = { x, y };
          lastMove = now;
          xTo(x);
          yTo(y);
        };
        const onLeave = () => {
          visible = false;
          active = -1;
          stopBloom();
          gsap.to(canvas, { autoAlpha: 0, duration: 0.6, ease: "power2.out", overwrite: "auto" });
        };
        const panelHandlers: { enter: () => void; leave: () => void }[] = [];
        // The brush waits until the panels have slid into place (see the inline loader).
        let armed = false;
        const arm = () => {
          if (armed) return;
          armed = true;
          resize();
          root.addEventListener("pointermove", onMove);
          root.addEventListener("pointerleave", onLeave);
          panels.forEach((panel, i) => {
            panel.addEventListener("pointerenter", panelHandlers[i].enter);
            panel.addEventListener("pointerleave", panelHandlers[i].leave);
          });
        };
        window.addEventListener("resize", resize);
        gsap.ticker.add(tick);

        // Hover effects: the shared scenes (src/lib/hero-scenes.ts) laid out as a collage
        // over the two dimmed panels — a large lead scene, the others smaller around it.
        // Designer dims centre + right; Developer dims left + centre.
        const fxs = createHeroScenes(root);
        const boards = {
          left: makeBoard([
            [fxs.vector, { cx: 0.36, cy: 0.36, w: 0.46 }],
            [fxs.type, { cx: 0.83, cy: 0.17, w: 0.26 }],
            [fxs.grid, { cx: 0.76, cy: 0.7, w: 0.34 }],
            [fxs.palette, { cx: 0.3, cy: 0.86, w: 0.34 }],
          ]),
          right: makeBoard([
            [fxs.flow, { cx: 0.6, cy: 0.24, w: 0.5 }],
            [fxs.web, { cx: 0.22, cy: 0.74, w: 0.3 }],
            [fxs.shop, { cx: 0.7, cy: 0.74, w: 0.26 }],
          ]),
        };
        // The area the scenes share while panel `i` is hovered: the visible span of the two
        // other panels, between the header and the footer.
        const dimmedArea = (i: number) => {
          const others = rects.filter((_, k) => k !== i);
          const x0 = Math.max(0, Math.min(...others.map((r) => r.x)));
          const x1 = Math.min(W, Math.max(...others.map((r) => r.x + r.w)));
          return { x: x0, y: H * 0.11, w: x1 - x0, h: H * 0.8 };
        };

        // Hovered panel: track it for the ink bloom and reveal its label.
        // designer: letters rise into place one by one (SplitText); developer: ScrambleText decode.
        const SCRAMBLE = "01<>/[]{}#*=+-";
        const panelCleanup = panels.map((panel, i) => {
          const label = panel.querySelector<HTMLElement>("[data-label]")!;
          const key = panel.dataset.panel;
          const isCenter = key === "center";
          const text = label.querySelector<HTMLElement>(".label-text");
          const original = text?.textContent ?? "";
          const split = key === "left" && text ? SplitText.create(text, { type: "chars", charsClass: "char" }) : null;
          const chars = (split?.chars ?? []) as HTMLElement[];
          const inFrom = key === "left" ? { xPercent: -140 } : { xPercent: 140 };
          const outTo = { xPercent: inFrom.xPercent * 0.5 };
          if (chars.length) gsap.set(chars, { autoAlpha: 0 });
          // Hover effects of the side panels, laid out together over the two dimmed panels.
          const board = key === "left" || key === "right" ? boards[key] : null;

          const enter = () => {
            active = i;
            stopBloom();
            const fx = FX_COLORS[key as keyof typeof FX_COLORS];
            if (fx) {
              root.style.setProperty("--fx-key", fx.key);
              root.style.setProperty("--fx-alt", fx.alt);
            }
            // Centre: its h1 is screen-reader only; the footer steps aside, and
            // let the ink reveal the whole work straight away (no need to rest).
            if (isCenter) {
              if (visible) startBloom(i);
              return (document.documentElement.dataset.heroCenter = "in");
            }
            gsap.killTweensOf([label, text, ...chars]);
            // Gentle eases and longer travel: the steep power3 curves read as a snap.
            gsap.fromTo(label, { ...inFrom, autoAlpha: 0 }, { xPercent: 0, autoAlpha: 1, duration: 1.2, ease: "power2.out" });
            if (split) {
              gsap.fromTo(
                chars,
                // Transform + opacity only (compositor work, no repaint): letters drift
                // up along the word and straighten as they settle, one after another.
                { autoAlpha: 0, yPercent: 45, rotation: -5 },
                { autoAlpha: 1, yPercent: 0, rotation: 0, duration: 1.1, ease: "power2.out", stagger: 0.07, delay: 0.15 },
              );
            } else if (text) {
              gsap.to(text, { duration: 1.3, scrambleText: { text: original, chars: SCRAMBLE, speed: 0.6 }, delay: 0.1 });
            }
            board?.start(dimmedArea(i));
          };
          const leave = () => {
            if (active === i) {
              active = -1;
              stopBloom();
            }
            if (isCenter) return (document.documentElement.dataset.heroCenter = "out");
            gsap.killTweensOf([label, text, ...chars]);
            if (text && !split) text.textContent = original;
            board?.stop();
            // Letters leave first with a light stagger, the word follows them out.
            if (split) gsap.to(chars, { autoAlpha: 0, yPercent: -20, duration: 0.5, ease: "power2.inOut", stagger: 0.025 });
            gsap.to(label, { ...outTo, autoAlpha: 0, duration: 0.7, ease: "power2.inOut", delay: split ? 0.1 : 0 });
          };
          panelHandlers[i] = { enter, leave };
          return () => {
            panel.removeEventListener("pointerenter", enter);
            panel.removeEventListener("pointerleave", leave);
            split?.revert();
            board?.revert();
          };
        });

        // Arm now if the load-in already finished (e.g. this block re-running after a
        // resize), otherwise when the panels have slid into place.
        if (root.dataset.ready) arm();
        else root.addEventListener("triptych:ready", arm, { once: true });

        return () => {
          root.removeEventListener("triptych:ready", arm);
          root.removeEventListener("pointermove", onMove);
          root.removeEventListener("pointerleave", onLeave);
          window.removeEventListener("resize", resize);
          gsap.ticker.remove(tick);
          stopBloom();
          panelCleanup.forEach((fn) => fn());
          gsap.set(canvas, { clearProps: "all" });
          gsap.killTweensOf(images);
          gsap.set(images, { clearProps: "opacity" });
          document.documentElement.removeAttribute("data-hero-center");
          root.style.removeProperty("--fx-key");
          root.style.removeProperty("--fx-alt");
          gsap.set(tints, { clearProps: "opacity" });
        };
      },
    );
  }
</script>
