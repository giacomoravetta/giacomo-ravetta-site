---
/**
 * Service subpage: big title and summary, then what the service includes (each item
 * with its description) and what it brings, and a contact CTA.
 * Content and colours in src/i18n/services.ts.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLangFromUrl, localizedPath, useTranslations } from "../i18n/utils";
import { services, serviceStyle, type ServiceId } from "../i18n/services";

interface Props {
  id: ServiceId;
}

const { id } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const service = services[id][lang];
const { key, font } = serviceStyle[id];
---

<BaseLayout title={service.name} description={service.summary} bgColour={key} bgShape={id}>
  <article class="flex flex-col gap-14" style={`--svc-key: ${key}`}>
    <a href={localizedPath("services", lang)} class="text-sm text-muted hover:text-foreground">← {t("services.back")}</a>
    <header class="flex max-w-3xl flex-col gap-5">
      <h1
        class:list={["text-5xl leading-[0.95] tracking-tight text-balance md:text-8xl", font]}
        data-title-reveal={id === "automation" ? "scramble" : "rise"}
      >
        {service.name}
      </h1>
      <p class="text-lg text-muted">{service.summary}</p>
    </header>

    <section class="flex flex-col" aria-labelledby="includes">
      <h2 id="includes" class="pb-4 text-xs font-semibold uppercase tracking-[0.15em] text-muted">{t("services.includes")}</h2>
      <ol class="flex flex-col">
        {
          service.items.map((item, i) => (
            <li class="grid gap-4 border-t border-muted/20 py-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-12">
              <div class="flex items-baseline gap-4">
                <span class="font-mono text-sm" style="color: var(--svc-key)">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class:list={["text-3xl tracking-tight", font]}>{item.name}</h3>
              </div>
              <p class="text-lg text-foreground/85">{item.summary}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="flex flex-col gap-5 border-t border-muted/20 pt-8" aria-labelledby="benefits">
      <h2 id="benefits" class="text-xs font-semibold uppercase tracking-[0.15em] text-muted">{t("services.benefits")}</h2>
      <ul class="grid gap-x-12 gap-y-4 md:grid-cols-2">
        {
          service.benefits.map((b) => (
            <li class="flex gap-3 text-lg">
              <span aria-hidden="true" class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full" style="background: var(--svc-key)" />
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <a
      href="mailto:info@giacomoravetta.com"
      class="self-start rounded-full bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-90"
    >
      {t("services.cta")}
    </a>
  </article>
</BaseLayout>
