---
/**
 * An animated 1-bit pixel figure for a service, drawn by `src/lib/pixel-figures.ts`
 * (loaded when the browser is idle). Fills its positioned parent; the ink is the
 * current text colour. Runs on the clock; builds up once when first on screen.
 * Decorative: hidden from assistive technology.
 */
import type { FigureId } from "../lib/pixel-figures";

interface Props {
  figure: FigureId;
  /** Build up again every time it comes back on screen (the phone menu), not just the first. */
  replay?: boolean;
  /** Further figures it dissolves to, in turn, every few seconds. */
  cycle?: FigureId[];
  /** A click or tap sends a ripple through it. */
  ripple?: boolean;
  /** Cells along the short side, for a finer or coarser grain than the default 96. */
  cells?: number;
  /** URL of muted, looping footage to dither live in place of the drawn figure. */
  video?: string;
}

const { figure, replay = false, cycle, ripple = false, cells, video } = Astro.props;
---

<div class="pixel-figure">
  <canvas
    data-figure={figure}
    data-figure-replay={replay ? "" : undefined}
    data-figure-cycle={cycle?.join(",")}
    data-figure-ripple={ripple ? "" : undefined}
    data-figure-cells={cells}
    data-figure-video={video}
    aria-hidden="true"></canvas>
</div>

<style>
  .pixel-figure {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  canvas {
    position: absolute;
    image-rendering: pixelated;
    visibility: hidden;
  }
  canvas[data-ready] {
    visibility: visible;
  }
</style>

<script>
  const canvases = [...document.querySelectorAll<HTMLCanvasElement>("canvas[data-figure]")];
  if (canvases.length) {
    const load = () => import("../lib/pixel-figures").then((m) => m.initFigures(canvases));
    if ("requestIdleCallback" in window) requestIdleCallback(load, { timeout: 1500 });
    else setTimeout(load, 200);
  }
</script>
