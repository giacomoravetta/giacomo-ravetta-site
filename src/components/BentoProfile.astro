---
import profile from "../assets/images/giacomo_ravetta_profile_final_social.webp";
---

<div class="profile-wrapper rounded-2xl overflow-hidden">
    <div class="absolute right-[5%] bottom-[5%] flex items-center justify-end gap-2 text-white text-[clamp(0.7rem,1.2vw,0.9rem)] max-[500px]:text-xs bg-black/40 backdrop-blur-sm px-3 py-2 max-[500px]:gap-2 rounded-lg whitespace-nowrap">
      <span>Available to work</span>
      <div class="w-[10px] h-[10px] max-[500px]:w-2 max-[500px]:h-2 relative flex-shrink-0 before:content-[''] before:absolute before:w-[300%] before:h-[300%] before:-top-full before:-left-full before:rounded-full before:bg-[rgba(50,237,140,0.3)] before:animate-[pulse-ring_2s_cubic-bezier(0.215,0.61,0.355,1)_infinite] after:content-[''] after:absolute after:w-full after:h-full after:bg-[rgb(50,237,140)] after:rounded-full after:shadow-[0_0_8px_rgba(0,0,0,0.3)] after:animate-[pulse-dot_2s_cubic-bezier(0.455,0.03,0.515,0.955)_-0.4s_infinite]"></div>
    </div>
  <img src={profile.src} width={profile.width} height={profile.height} alt="Hi, I am Giacomo" class="profile-image" />
</div>

<style>

    .profile-wrapper {
      position: relative;
      width: fit-content;
    }

    .profile-image {
      min-width: 10%;
      max-width: 100%;
    }

    @media only screen and (min-width: 768px) {
      .profile-wrapper {
        width: 100%;
        height: 100%;
      }

      .profile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
      }
    }
</style>
