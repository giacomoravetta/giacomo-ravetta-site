---
import { languages, type Lang, type RouteKey } from "../i18n/ui";
import { getRouteFromUrl, localizedPath, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const current = getRouteFromUrl(Astro.url);
// Subpages of Services keep "Services" highlighted in the nav.
const isCurrent = (key: RouteKey) =>
  current === key || (key === "services" && (current === "designer" || current === "developer"));

const nav: { key: RouteKey; label: string }[] = [
  { key: "home", label: t("nav.home") },
  { key: "work", label: t("nav.work") },
  { key: "services", label: t("nav.services") },
  { key: "about", label: t("nav.about") },
];
const langs = Object.keys(languages) as Lang[];
---

<!--
  Desktop (md+): floating frosted pill, sticky, 70dvw wide.
  Phones: compact full-width frosted bar fixed over the content, with a menu
  button that opens a full-screen menu (nav + language switcher).
-->
<header
  class="site-header glass fixed inset-x-3 top-3 z-50 rounded-lg md:sticky md:inset-x-auto md:top-4 md:mx-auto md:mt-4 md:w-[min(70dvw,64rem)]"
  data-header
>
  <div class="flex w-full items-center justify-between gap-4 px-5 py-3 md:gap-6 md:px-6 md:py-4">
    <a href={localizedPath("home", lang)} class="font-semibold tracking-tight">{t("site.name")}</a>

    <!-- Desktop nav -->
    <nav aria-label="Main" class="hidden items-center gap-6 text-sm md:flex">
      <ul class="flex items-center gap-5">
        {
          nav.map(({ key, label }) => (
            <li>
              <a
                href={localizedPath(key, lang)}
                aria-current={isCurrent(key) ? "page" : undefined}
                class="text-muted transition-colors hover:text-foreground aria-[current=page]:text-foreground"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <ul aria-label={t("nav.language")} class="flex items-center gap-2 border-l border-muted/30 pl-5">
        {
          langs.map((code) => (
            <li>
              <a
                href={localizedPath(current, code)}
                hreflang={code}
                lang={code}
                aria-current={code === lang ? "true" : undefined}
                class="uppercase text-muted transition-colors hover:text-foreground aria-[current=true]:text-foreground"
              >
                {code}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Phone menu button -->
    <button
      type="button"
      class="-mr-2 flex h-10 w-10 items-center justify-center rounded-full md:hidden"
      aria-label={t("nav.menu.open")}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-label-open={t("nav.menu.open")}
      data-label-close={t("nav.menu.close")}
      data-menu-toggle
    >
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<!-- Phone menu: full-screen frosted overlay -->
<div
  id="mobile-menu"
  class="mobile-menu fixed inset-0 z-45 hidden flex-col justify-end px-6 pt-24 pb-20 md:hidden!"
  data-menu
>
  <nav aria-label="Main">
    <ul class="flex flex-col gap-3 text-4xl font-semibold tracking-tight">
      {
        nav.map(({ key, label }, i) => (
          <li style={`--i: ${i}`} data-menu-item>
            <a
              href={localizedPath(key, lang)}
              aria-current={isCurrent(key) ? "page" : undefined}
              class="block py-1 text-foreground/70 aria-[current=page]:text-foreground"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ul aria-label={t("nav.language")} class="mt-10 flex items-center gap-4 text-sm" style={`--i: ${nav.length}`} data-menu-item>
    {
      langs.map((code) => (
        <li>
          <a
            href={localizedPath(current, code)}
            hreflang={code}
            lang={code}
            aria-current={code === lang ? "true" : undefined}
            class="uppercase text-muted aria-[current=true]:text-foreground"
          >
            {languages[code]}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .mobile-menu {
    background: color-mix(in oklab, var(--color-background) 70%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    backdrop-filter: blur(24px) saturate(140%);
  }
  .mobile-menu.is-open {
    display: flex;
  }
  /* Items rise in one after another when the menu opens. */
  .mobile-menu.is-open [data-menu-item] {
    animation: menu-item-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(0.05s + var(--i, 0) * 0.06s);
  }
  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Two bars that become a cross. */
  .menu-icon {
    position: relative;
    display: block;
    width: 20px;
    height: 12px;
  }
  .menu-icon i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      top 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu-icon i:first-child {
    top: 0;
  }
  .menu-icon i:last-child {
    top: 10px;
  }
  [aria-expanded="true"] .menu-icon i:first-child {
    top: 5px;
    transform: rotate(45deg);
  }
  [aria-expanded="true"] .menu-icon i:last-child {
    top: 5px;
    transform: rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu.is-open [data-menu-item] {
      animation: none;
    }
    .menu-icon i {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  if (toggle && menu) {
    const openLabel = toggle.dataset.labelOpen ?? "";
    const closeLabel = toggle.dataset.labelClose ?? "";

    const setOpen = (open: boolean) => {
      menu.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? closeLabel : openLabel);
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => setOpen(!menu.classList.contains("is-open")));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.classList.contains("is-open")) setOpen(false);
    });
    // Close if the viewport grows past the phone breakpoint while open.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
