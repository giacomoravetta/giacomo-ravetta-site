---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { languages, type Lang } from "../i18n/ui";
import { getLangFromUrl, getRouteFromUrl, localizedPath, useTranslations } from "../i18n/utils";

interface Props {
  title: string;
  description?: string;
  /** Drop the content container so a section can span the full viewport width;
   *  the footer then floats over the content instead of sitting below it. */
  fullBleed?: boolean;
}

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const route = getRouteFromUrl(Astro.url);

const { title, description = t("site.description"), fullBleed = false } = Astro.props;
const fullTitle = route === "home" ? `${t("site.name")} — ${t("site.tagline")}` : `${title} — ${t("site.name")}`;
const site = Astro.site ?? new URL("http://localhost:4321");
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: new URL(localizedPath(route, code), site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(localizedPath(route, lang), site).href} />
    {alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_US"} />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/BluuNext-Bold.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/TerminalGrotesque.woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class="flex min-h-svh flex-col font-instrument antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:rounded focus:bg-foreground focus:px-3 focus:py-2 focus:text-background"
    >
      {t("nav.skip")}
    </a>
    <Header lang={lang} />
    <main id="main" class:list={["w-full flex-1", !fullBleed && "mx-auto max-w-5xl px-6 py-16 max-md:pt-24"]}>
      <slot />
    </main>
    <Footer lang={lang} overlay={fullBleed} />
    <script>
      // Page titles replay their Home hero word animation:
      // [data-title-reveal="rise"] letters settle one by one (like "designer"),
      // [data-title-reveal="scramble"] decodes (like "developer").
      import gsap from "gsap";
      import { SplitText } from "gsap/SplitText";
      import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";

      gsap.registerPlugin(SplitText, ScrambleTextPlugin);
      gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
        document.querySelectorAll<HTMLElement>("[data-title-reveal]").forEach((el) => {
          if (el.dataset.titleReveal === "rise") {
            const split = SplitText.create(el, { type: "chars" });
            gsap.fromTo(
              split.chars,
              { autoAlpha: 0, yPercent: 45, rotation: -5 },
              { autoAlpha: 1, yPercent: 0, rotation: 0, duration: 1.1, ease: "power2.out", stagger: 0.07, delay: 0.15 },
            );
          } else {
            const text = el.textContent ?? "";
            gsap.to(el, { duration: 1.3, scrambleText: { text, chars: "01<>/[]{}#*=+-", speed: 0.6 }, delay: 0.1 });
          }
        });
      });
    </script>
  </body>
</html>
