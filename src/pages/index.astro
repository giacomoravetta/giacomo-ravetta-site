---
import BaseLayout from "../layouts/BaseLayout.astro";
import Triptych from "../components/Triptych.astro";
import MobileTriptych from "../components/MobileTriptych.svelte";
import HeroScenes from "../components/HeroScenes.astro";
import { getLangFromUrl, localizedPath, useTranslations } from "../i18n/utils";
import { getTriptychImages, DESKTOP_QUERY, MOBILE_QUERY } from "../lib/triptych-images";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Home side panels → Services subpages; the centre → About me.
const pageFor = { left: "designer", right: "developer" } as const;
const images = await getTriptychImages();
// Mobile variants (capped at 960px), see getTriptychImages.
const mobilePanels = images.map((p) => ({
  key: p.key,
  src: p.mobileImg.src,
  srcset: p.mobileImg.srcSet.attribute,
  avifSrcset: p.mobileAvif.srcSet.attribute,
  sizes: p.sizes,
  width: Number(p.mobileImg.attributes.width),
  height: Number(p.mobileImg.attributes.height),
  alt: t(`hero.alt.${p.key}`),
  label: t(`hero.${p.key}`),
  href: p.key === "center" ? undefined : localizedPath(pageFor[p.key], lang),
}));
---

<BaseLayout title={t("home.title")} fullBleed>
  <Fragment slot="head">
    {
      /* Start fetching the hero panels before the body is parsed: all three on desktop
         (the whole strip is on screen), only the first on phones (the others are a swipe
         away and load right after). type="image/avif": browsers without AVIF skip the
         preload and fall back to the WebP in <picture>. */
      images.map((p) => (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          imagesrcset={p.avif.srcSet.attribute}
          imagesizes={p.sizes}
          media={DESKTOP_QUERY}
          fetchpriority="high"
        />
      ))
    }
    {
      images
        .filter((p) => p.key === "left")
        .map((p) => (
          <link
            rel="preload"
            as="image"
            type="image/avif"
            imagesrcset={p.mobileAvif.srcSet.attribute}
            imagesizes={p.sizes}
            media={MOBILE_QUERY}
            fetchpriority="high"
          />
        ))
    }
  </Fragment>
  <!--
    Wide screens with a mouse: pointer-driven brush triptych.
    Phones, tablets (iPad included) and any touch device: scroll-driven Svelte version.
    The media query below must match SCROLL_HERO_QUERY in global.css.
  -->
  <Triptych lang={lang} images={images} />
  <div class="scroll-hero">
    <MobileTriptych client:media="(max-width: 1023px), (hover: none), (pointer: coarse)" panels={mobilePanels}>
      <HeroScenes lang={lang} />
    </MobileTriptych>
  </div>
</BaseLayout>
