---
import BaseLayout from "../layouts/BaseLayout.astro";
import Triptych from "../components/Triptych.astro";
import MobileTriptych from "../components/MobileTriptych.svelte";
import { getLangFromUrl, localizedPath, useTranslations } from "../i18n/utils";
import { getTriptychImages } from "../lib/triptych-images";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Home side panels → Services subpages; the centre → About me.
const pageFor = { left: "designer", center: "about", right: "developer" } as const;
const images = await getTriptychImages();
// Same variants as the desktop triptych, so both share the cache and the head preloads.
const mobilePanels = images.map((p) => ({
  key: p.key,
  src: p.img.src,
  srcset: p.img.srcSet.attribute,
  sizes: p.sizes,
  width: Number(p.img.attributes.width),
  height: Number(p.img.attributes.height),
  alt: t(`hero.alt.${p.key}`),
  label: t(`hero.${p.key}`),
  href: localizedPath(pageFor[p.key], lang),
  // Centre caption, same as the desktop hero.
  caption: p.key === "center" ? t("nav.about") : undefined,
}));
---

<BaseLayout title={t("home.title")} fullBleed>
  <Fragment slot="head">
    {
      /* Start fetching the hero panels before the body is parsed. */
      images.map((p) => (
        <link
          rel="preload"
          as="image"
          href={p.img.src}
          imagesrcset={p.img.srcSet.attribute}
          imagesizes={p.sizes}
          fetchpriority="high"
        />
      ))
    }
  </Fragment>
  <!--
    Wide screens with a mouse: pointer-driven brush triptych.
    Phones, tablets (iPad included) and any touch device: scroll-driven Svelte version.
    The media query below must match SCROLL_HERO_QUERY in global.css.
  -->
  <Triptych lang={lang} images={images} />
  <div class="scroll-hero">
    <MobileTriptych client:media="(max-width: 1023px), (hover: none), (pointer: coarse)" panels={mobilePanels} />
  </div>
</BaseLayout>
