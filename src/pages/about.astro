---
/**
 * About me. Desktop: the portrait on the left (two fifths), title and text on the right.
 * Phones: title, portrait, text. The portrait is the plain photograph, framed like the
 * rest of the site (no dither or hover effect, at Giacomo's request).
 * Below the text: a few facts as tags and the link to the CV; then, full width, the
 * booking call to action (the page is `fullBleed` and keeps its own content column).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import profile from "../assets/giacomo-profile-2026.webp";
import { getLangFromUrl, localizedPath, useTranslations } from "../i18n/utils";
import SplitWord from "../components/SplitWord.astro";
import BookingCta from "../components/BookingCta.astro";
import { cv } from "../i18n/cv";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/** What shaped me, at a glance. */
const facts = {
  en: ["Based in Saronno", "Philosophy degree", "Photography", "Chess", "Ukulele"],
  it: ["A Saronno", "Laurea in Filosofia", "Fotografia", "Scacchi", "Ukulele"],
}[lang];
---

<BaseLayout title={t("about.title")} description={t("about.intro")} fullBleed>
  <article class="mx-auto grid max-w-5xl px-6 pt-16 pb-24 max-md:pt-32 gap-x-12 gap-y-8 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:items-start">
    <!-- Same letters-rise animation as before, now in the pixel face of the Home slogan. -->
    <h1 class="title-letters font-terminal text-6xl leading-none tracking-tight md:col-start-2 md:text-7xl lg:text-8xl">
      <SplitWord text={t("about.heading")} />
    </h1>

    <!-- Original file, untouched: no re-encoding so the portrait stays as sharp as the source. -->
    <img
      src={profile.src}
      width={profile.width}
      height={profile.height}
      alt={t("about.photo.alt")}
      class="portrait md:col-start-1 md:row-span-2 md:row-start-1"
      loading="eager"
      decoding="async"
    />

    <div class="flex flex-col gap-6 md:col-start-2">
      <p class="text-xl leading-snug lg:text-2xl">{t("about.intro")}</p>
      <ul class="flex flex-wrap gap-2 font-terminal text-sm">
        {facts.map((fact) => <li class="border-2 border-foreground px-2.5 py-1">{fact}</li>)}
      </ul>
      <p class="text-lg">{t("about.body")}</p>
      <!-- Same paragraph as the last one of "My story" on the CV (trusted HTML: Lichess link). -->
      <p class="about-hobby text-lg" set:html={cv[lang].story.at(-1)} />

      <section class="mt-4 flex flex-col items-start gap-3 border-t-2 border-foreground pt-8">
        <h2 class="font-terminal text-3xl tracking-tight">{t("about.cv.heading")}</h2>
        <p class="text-lg">{t("about.cv.body")}</p>
        <a href={localizedPath("cv", lang)} class="btn mt-2 border-2 border-foreground px-5 py-3 text-lg font-semibold">
          {t("about.cv.link")} <span aria-hidden="true">→</span>
        </a>
      </section>
    </div>
  </article>

  <BookingCta lang={lang} />
</BaseLayout>

<style>
  .about-hobby :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* 1-bit: states switch, they do not fade. */
  .btn {
    background: var(--color-foreground);
    color: var(--color-background);
    box-shadow: 4px 4px 0 var(--color-foreground);
  }
  .btn:hover,
  .btn:focus-visible {
    background: var(--color-background);
    color: var(--color-foreground);
  }
  /* Portrait: the plain photograph in the site's frame. */
  .portrait {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    border: 2px solid var(--color-foreground);
    box-shadow: 6px 6px 0 var(--color-foreground);
  }
  @media (min-width: 48rem) {
    .portrait {
      max-width: none;
    }
  }
</style>
