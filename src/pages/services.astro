---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLangFromUrl, localizedPath, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sections = [
  { key: "designer", title: t("services.designer.title"), body: t("services.designer.body") },
  { key: "developer", title: t("services.developer.title"), body: t("services.developer.body") },
] as const;
---

<BaseLayout title={t("services.title")}>
  <section class="flex flex-col gap-10">
    <header class="flex max-w-2xl flex-col gap-4">
      <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">{t("services.heading")}</h1>
      <p class="text-lg text-muted">{t("services.intro")}</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {
        sections.map(({ key, title, body }) => (
          <a
            href={localizedPath(key, lang)}
            class:list={[
              "group flex flex-col gap-4 rounded-2xl border border-muted/20 p-8 transition-colors hover:border-foreground/60",
            ]}
          >
            <h2 class:list={["text-4xl tracking-tight md:text-5xl", key === "designer" ? "font-bluu" : "font-terminal"]}>{title}</h2>
            <p class="text-muted">{body}</p>
            <span class="mt-auto text-sm text-foreground/80 group-hover:text-foreground">{t("services.more")} →</span>
          </a>
        ))
      }
    </div>

    <a
      href="mailto:info@giacomoravetta.com"
      class="self-start rounded-full bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-90"
    >
      {t("services.cta")}
    </a>
  </section>
</BaseLayout>
