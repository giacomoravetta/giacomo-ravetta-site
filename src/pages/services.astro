---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Anchor ids are language-independent so the Home panels can link to them from both locales.
const sections = [
  { id: "designer", title: t("services.designer.title"), body: t("services.designer.body") },
  { id: "developer", title: t("services.developer.title"), body: t("services.developer.body") },
];
---

<BaseLayout title={t("services.title")}>
  <section class="flex flex-col gap-10">
    <header class="flex max-w-2xl flex-col gap-4">
      <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">{t("services.heading")}</h1>
      <p class="text-lg text-muted">{t("services.intro")}</p>
    </header>

    {
      sections.map(({ id, title, body }) => (
        <section id={id} class="flex scroll-mt-28 flex-col gap-4 border-t border-muted/20 pt-10" data-service={id}>
          <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">{title}</h2>
          <p class="max-w-2xl text-lg text-muted">{body}</p>
          <p class="text-sm text-muted/70">{t("services.soon")}</p>
        </section>
      ))
    }

    <a
      href="mailto:info@giacomoravetta.com"
      class="self-start rounded-full bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-90"
    >
      {t("services.cta")}
    </a>
  </section>
</BaseLayout>
